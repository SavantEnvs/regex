# Mayhem target: regex's ast_fuzz_match fuzzer (libFuzzer, built by mayhem/build.sh via cargo-fuzz at /mayhem/ast_fuzz_match).
# Seeds are the upstream in-tree regression corpus for this target (fuzz/regressions/), staged into
# mayhem/ast_fuzz_match/testsuite/ by the integration.
project: savantenvs/regex
target: ast_fuzz_match
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/ast_fuzz_match/testsuite
cmds:
  - cmd: /mayhem/ast_fuzz_match
    libfuzzer: true
