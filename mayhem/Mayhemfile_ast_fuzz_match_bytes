# Mayhem target: regex's ast_fuzz_match_bytes fuzzer (libFuzzer, built by mayhem/build.sh via cargo-fuzz at /mayhem/ast_fuzz_match_bytes).
# Seeds are the upstream in-tree regression corpus for this target (fuzz/regressions/), staged into
# mayhem/ast_fuzz_match_bytes/testsuite/ by the integration.
project: savantenvs/regex
target: ast_fuzz_match_bytes
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/ast_fuzz_match_bytes/testsuite
cmds:
  - cmd: /mayhem/ast_fuzz_match_bytes
    libfuzzer: true
