# Mayhem target: regex's fuzz_regex_match fuzzer (libFuzzer, built by mayhem/build.sh via cargo-fuzz at /mayhem/fuzz_regex_match).
# Seeds are the upstream in-tree regression corpus for this target (fuzz/regressions/), staged into
# mayhem/fuzz-regex-match/testsuite/ by the integration.
project: savantenvs/regex
target: fuzz-regex-match
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/fuzz-regex-match/testsuite
cmds:
  - cmd: /mayhem/fuzz_regex_match
    libfuzzer: true
